{
  "name": {
    "zh-cn": "AI机甲双驱车",
    "en": "AI Mech"
  },
  "description": {
    "zh-cn": "适用于 AI机甲双驱车的 Python 积木拓展包。",
    "en": "Python block extension for AI Mech."
  },
  "author": "Hiwonder",
  "license": "MIT",
  "isBoard": false,
  "id": "aimech",
  "platform": [
    "win",
    "mac",
    "web",
    "linux"
  ],
  "version": "1.0.4",
  "scratchEditor": {
    "color1": "#1874cd",
    "color2": "#1874cd",
    "color3": "#1874cd",
    "categories": [
      {
        "id": "main",
        "name": "主程序",
        "hideLabel": true,
        "blocks": [
          "start_thread",
          "start_run_thread"
        ]
      },
      {
        "id": "boardResource",
        "name": "板载资源",
        "hideLabel": false,
        "blocks": [
          "buzzer_tone_set",
          "buzzer_tone_set_arg",
          "buzzer_tone_set_volume",
          "close_buzzer",
          "close_lowpower_warning",
          "get_battery_level"
        ]
      },
      {
        "id": "rgb",
        "name": "RGB彩灯",
        "hideLabel": false,
        "blocks": [
          "set_led_color",
          "set_led_color_arg",
          "rgb_module_breath_one",
          "rgb_module_breath",
          "close_led"
        ]
      },
      {
        "id": "output",
        "name": "输出打印",
        "hideLabel": false,
        "blocks": [
          "print_str",
          "print_number"
        ]
      },
      {
        "id": "button",
        "name": "按键",
        "hideLabel": false,
        "blocks": [
          "when_key_click_thread",
          "when_key_longclick_thread",
          "key_is_pressed"
        ]
      },
      {
        "id": "motion",
        "name": "编码电机控制",
        "hideLabel": false,
        "blocks": [
          "motor_speed_set",
          "set_motor_run_distance",
          "set_motor_run_oriention_angle",
          "set_motor_run_speed",
          "set_motor_run_angle",
          "set_motor_run_two_wheel",
          "set_motor_run_two_wheel_percent",
          "set_motor_stop",
          "get_servo_run_angle",
          "reset_run_angle",
          "pd_set_pd_line"
        ]
      },
      {
        "id": "imu",
        "name": "IMU传感器",
        "hideLabel": false,
        "blocks": [
          "imu_init",
          "imu_cali",
          "get_euler_angle_element_value"
        ]
      },
      {
        "id": "bluetooth",
        "name": "蓝牙通信",
        "hideLabel": false,
        "blocks": [
          "set_ble_mode",
          "ble_is_connected",
          "get_ble_mac",
          "ble_wait_end",
          "read_ble_data",
          "get_ble_cmd",
          "get_ble_args",
          "ble_write"
        ]
      }
    ],
    "blocks": {
      "start_thread": {
        "launcher": "Hiwonder.startMain({MAIN})",
        "section": "main"
      },
      "start_run_thread": {
        "section": "setup"
      },
      "when_key_click_thread": {
        "entryTemplate": "def on_button{KEYS}_clicked():",
        "entryFooter": "button{KEYS}.Clicked(on_button{KEYS}_clicked)",
        "section": "main"
      },
      "when_key_longclick_thread": {
        "entryTemplate": "def on_button{KEYS}_longpressed():",
        "entryFooter": "button{KEYS}.Longpressed(on_button{KEYS}_longpressed)",
        "section": "main"
      },
      "set_motor_run_speed": {
        "templateSelector": {
          "argument": "WHEEL",
          "cases": {
            "0": "motor.motors_run_rpm({SPEED},{SPEED})"
          }
        },
        "arguments": {
          "SPEED": {
            "type": "slider150p"
          }
        }
      },
      "set_motor_run_angle": {
        "templateSelector": {
          "argument": "WHEEL",
          "cases": {
            "0": "motor.motor_run_angle(1,{ANGLE},{SPEED})\nmotor.motor_run_angle(2,{ANGLE},{SPEED})"
          }
        },
        "arguments": {
          "SPEED": {
            "type": "slider150"
          }
        }
      },
      "reset_run_angle": {
        "templateSelector": {
          "argument": "WHEEL",
          "cases": {
            "0": "motor.reset_motor_angle(1)\nmotor.reset_motor_angle(2)"
          }
        }
      },
      "buzzer_tone_set_volume": {
        "arguments": {
          "VALUE": {
            "type": "slider"
          }
        }
      },
      "set_led_color": {
        "arguments": {
          "COLOR": {
            "type": "square_color"
          }
        }
      },
      "set_led_color_arg": {
        "arguments": {
          "RED": {
            "type": "slider255"
          },
          "GREEN": {
            "type": "slider255"
          },
          "BLUE": {
            "type": "slider255"
          }
        }
      },
      "motor_speed_set": {
        "arguments": {
          "SPEED": {
            "type": "slider150"
          }
        }
      },
      "set_motor_run_distance": {
        "arguments": {
          "SPEED": {
            "type": "slider150"
          }
        }
      },
      "set_motor_run_oriention_angle": {
        "arguments": {
          "SPEED": {
            "type": "slider150"
          }
        }
      },
      "set_motor_run_two_wheel": {
        "arguments": {
          "SPEED": {
            "type": "slider150p"
          },
          "SPEED2": {
            "type": "slider150p"
          }
        }
      },
      "set_motor_run_two_wheel_percent": {
        "arguments": {
          "SPEED": {
            "type": "slider100"
          },
          "SPEED2": {
            "type": "slider100"
          }
        }
      }
    }
  },
  "asset": {
    "python": {
      "dir": "python/",
      "version": "1.0.4",
      "main": "main.ts",
      "dependencies": {},
      "files": [
        "_menus/index.json"
      ]
    }
  }
}
