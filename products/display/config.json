      "oled_draw_rect": {
        "products": [
          "aimech",
          "aimecanum",
          "aiquadruped",
          "aiquadrupedpro",
          "aihexa",
          "aiblocksboard"
        ],
        "templateSelector": {
          "argument": "SHAPE",
          "cases": {
            "0": "my_oled.rect({XPOS},{YPOS},{XPOS1},{YPOS1})",
            "1": "my_oled.fill_rect({XPOS},{YPOS},{XPOS1},{YPOS1})"
          }
        },
        "blockIcon": "_images/blocks/oled.svg"
      },
      "mp3_play_control": {
        "templateSelector": {
          "argument": "PLAYSTATUS",
          "cases": {
            "0": "mp3.play()",
            "1": "mp3.pause()",
            "2": "mp3.prev()",
            "3": "mp3.next()"
          }
        },
        "blockIcon": "_images/blocks/mp3.svg"
      },
      "mp3_play_mode": {
        "templateSelector": {
          "argument": "PLAYMODE",
          "cases": {
            "0": "mp3.loop_on()",
            "1": "mp3.loop_off()"
          }
        },
        "blockIcon": "_images/blocks/mp3.svg"
      },
      "rgb_color_set": {
        "templateSelector": {
          "argument": "NUMS",
          "cases": {
            "15": "myrgb_{PORT}.fill({RED},{GREEN},{BLUE})\nmyrgb_{PORT}.write()"
          }
        },
        "blockIcon": "_images/blocks/strip.svg"
      },
      "led_color_select": {
        "templateSelector": {
          "argument": "NUMS",
          "cases": {
            "15": "myrgb_{PORT}.fill({COLOR.rgb})\nmyrgb_{PORT}.write()"
          }
        },
        "blockIcon": "_images/blocks/strip.svg"
      },
      "led_close": {
        "templateSelector": {
          "argument": "NUMS",
          "cases": {
            "15": "myrgb_{PORT}.clear()"
          }
        },
        "blockIcon": "_images/blocks/strip.svg"
