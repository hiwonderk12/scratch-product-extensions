{
  "name": {
    "zh-cn": "AI机甲四足机器人",
    "en": "AI Quadruped"
  },
  "description": {
    "zh-cn": "适用于 AI机甲四足机器人的 Python 积木拓展包。",
    "en": "Python block extension for AI Quadruped."
  },
  "author": "Hiwonder",
  "license": "MIT",
  "isBoard": false,
  "id": "aiquadruped",
  "platform": [
    "win",
    "mac",
    "web",
    "linux"
  ],
  "version": "1.0.6",
  "scratchEditor": {
    "color1": "#1874cd",
    "color2": "#1874cd",
    "color3": "#1874cd",
    "categories": [
      {
        "id": "main",
        "name": "主程序",
        "hideLabel": true,
        "blocks": [
          "start_thread",
          "start_run_thread"
        ]
      },
      {
        "id": "boardResource",
        "name": "板载资源",
        "hideLabel": false,
        "blocks": [
          "buzzer_tone_set",
          "buzzer_tone_set_arg",
          "buzzer_tone_set_volume",
          "close_buzzer",
          "close_lowpower_warning",
          "get_battery_level"
        ]
      },
      {
        "id": "rgb",
        "name": "RGB彩灯",
        "hideLabel": false,
        "blocks": [
          "set_led_color",
          "set_led_color_arg",
          "rgb_module_breath_one",
          "rgb_module_breath",
          "close_led"
        ]
      },
      {
        "id": "output",
        "name": "输出打印",
        "hideLabel": false,
        "blocks": [
          "print_str",
          "print_number"
        ]
      },
      {
        "id": "button",
        "name": "按键",
        "hideLabel": false,
        "blocks": [
          "when_key_click_thread",
          "when_key_longclick_thread",
          "key_is_pressed"
        ]
      },
      {
        "id": "motion",
        "name": "运动控制",
        "hideLabel": false,
        "blocks": [
          "robot_reset",
          "robot_move_step",
          "robot_move",
          "robot_move_offset",
          "robot_move_step_arg",
          "robot_stop_run",
          "robot_run_action",
          "robot_servo_set",
          "get_robot_servo_pos"
        ]
      },
      {
        "id": "imu",
        "name": "IMU传感器",
        "hideLabel": false,
        "blocks": [
          "imu_init",
          "imu_cali",
          "get_euler_angle_element_value"
        ]
      },
      {
        "id": "bluetooth",
        "name": "蓝牙通信",
        "hideLabel": false,
        "blocks": [
          "set_ble_mode",
          "ble_is_connected",
          "get_ble_mac",
          "ble_wait_end",
          "read_ble_data",
          "get_ble_cmd",
          "get_ble_args",
          "ble_write"
        ]
      }
    ],
    "blocks": {
      "start_thread": {
        "launcher": "Hiwonder.startMain({MAIN})",
        "section": "main"
      },
      "start_run_thread": {
        "section": "setup"
      },
      "when_key_click_thread": {
        "entryTemplate": "def on_button{KEYS}_clicked():",
        "entryFooter": "button{KEYS}.Clicked(on_button{KEYS}_clicked)",
        "section": "main"
      },
      "when_key_longclick_thread": {
        "entryTemplate": "def on_button{KEYS}_longpressed():",
        "entryFooter": "button{KEYS}.Longpressed(on_button{KEYS}_longpressed)",
        "section": "main"
      },
      "set_led_color": {
        "arguments": {
          "COLOR": {
            "type": "square_color"
          }
        }
      },
      "robot_move_step": {
        "arguments": {
          "STEP": {
            "type": "slider127"
          }
        }
      },
      "buzzer_tone_set_volume": {
        "arguments": {
          "VALUE": {
            "type": "slider"
          }
        }
      },
      "set_led_color_arg": {
        "arguments": {
          "RED": {
            "type": "slider255"
          },
          "GREEN": {
            "type": "slider255"
          },
          "BLUE": {
            "type": "slider255"
          }
        }
      },
      "robot_run_action": {
        "arguments": {
          "STEP": {
            "type": "slider127"
          }
        }
      }
    }
  },
  "asset": {
    "python": {
      "dir": "python/",
      "version": "1.0.6",
      "main": "main.ts",
      "dependencies": {},
      "files": [
        "_menus/index.json"
      ]
    }
  }
}
