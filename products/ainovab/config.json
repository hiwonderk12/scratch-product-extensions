  "version": "0.1.2",
  "scratchEditor": {
    "color1": "#EF8C4D",
    "color2": "#EF8C4D",
    "color3": "#EF8C4D",
    "categories": [
      {
        "id": "main",
        "name": {
          "zh-cn": "主程序",
          "en": "Main program",
          "zh-tw": "主程式",
          "ko": "메인 프로그램"
        },
        "hideLabel": true,
        "blocks": [
          "start_thread",
          "start_run_thread"
        ]
      },
      {
        "id": "controller",
        "name": {
          "zh-cn": "CoreX控制器",
          "en": "CoreX Board",
          "zh-tw": "CoreX控制器",
          "ko": "CoreX 보드"
        },
      "blocks": ["when_key_click_thread","when_key_long_pressed_thread","en_motorSetType","en_motorResetCounter","en_motorSetSpeed","en_motorSetSpeedArg","en_motorGetSpeed","en_motorGetCounter","en_motorStop","en_motorDrawInit","en_motorDrawPutData","en_motorTurn","motor_speed_set","motor_speed_set_arg","motor_speed_set_wheel","motor_speed_stop","pid_value","set_pid_value","update_pid_value","output_pid_value","reset_pid_value","print_str","print_number","led_color_set","led_color_set_arg","led_color_select","led_close","buzzer_tone_set","buzzer_tone_set_arg","buzzer_play_melody","set_buzzer_bpm","get_buzzer_bpm","set_buzzer_volume","buzzer_isFinish","disable_lowPower_alarm","key_detect","get_sound","get_battery_level","set_ble_mode","ble_is_connected","get_ble_mac","ble_wait_end","read_ble_data","get_ble_cmd","get_ble_args","ble_write","when_get_irkey_thread","when_irkey_longPress_thread","when_irkey_stop_thread","send_irkey","learn_mode","send_learn_code"],
      "subcategories": [
          {
            "id": "events",
            "name": {
              "zh-cn": "事件程序",
              "en": "events",
              "zh-tw": "事件程序",
              "ko": "이벤트"
            },
            "blocks": [
              "when_key_click_thread",
              "when_key_long_pressed_thread"
            ]
          },
          {
            "id": "encoder",
            "name": {
              "zh-cn": "编码电机",
              "en": "Encoder motor",
              "zh-tw": "編碼電機",
              "ko": "엔코더 모터"
            },
            "blocks": [
              "en_motorSetType",
              "en_motorResetCounter",
              "en_motorSetSpeed",
              "en_motorSetSpeedArg",
              "en_motorGetSpeed",
              "en_motorGetCounter",
              "en_motorStop",
              "en_motorDrawInit",
              "en_motorDrawPutData",
              "en_motorTurn"
            ]
          },
          {
            "id": "motor",
            "name": {
              "zh-cn": "普通电机",
              "en": "motor control",
              "zh-tw": "普通電機",
              "ko": "모터 컨트롤"
            },
            "blocks": [
              "motor_speed_set",
              "motor_speed_set_arg",
              "motor_speed_set_wheel",
              "motor_speed_stop"
            ]
          },
          {
            "id": "pid",
            "name": {
              "zh-cn": "PID控制器",
              "en": "PID controller",
              "zh-tw": "PID控制器",
              "ko": "PID 컨트롤러"
            },
            "blocks": [
              "pid_value",
              "set_pid_value",
              "update_pid_value",
              "output_pid_value",
              "reset_pid_value"
            ]
          },
          {
            "id": "output",
            "name": {
              "zh-cn": "输出打印",
              "en": "output",
              "zh-tw": "輸出列印",
              "ko": "출력"
            },
            "blocks": [
              "print_str",
              "print_number"
            ]
          },
          {
            "id": "led",
            "name": {
              "zh-cn": "LED控制",
              "en": "LED control",
              "zh-tw": "LED控制",
              "ko": "LED 제어"
            },
            "blocks": [
              "led_color_set",
              "led_color_set_arg",
              "led_color_select",
              "led_close"
            ]
          },
          {
            "id": "board",
            "name": {
              "zh-cn": "板载资源",
              "en": "board resource",
              "zh-tw": "板載資源",
              "ko": "보드 자원"
            },
            "blocks": [
              "buzzer_tone_set",
              "buzzer_tone_set_arg",
              "buzzer_play_melody",
              "set_buzzer_bpm",
              "get_buzzer_bpm",
              "set_buzzer_volume",
              "buzzer_isFinish",
              "disable_lowPower_alarm",
              "key_detect",
              "get_sound",
              "get_battery_level"
            ]
          },
          {
            "id": "bluetooth",
            "name": {
              "zh-cn": "蓝牙通信",
              "en": "Bluetooth",
              "zh-tw": "藍牙通信",
              "ko": "블루투스"
            },
            "blocks": [
              "set_ble_mode",
              "ble_is_connected",
              "get_ble_mac",
              "ble_wait_end",
              "read_ble_data",
              "get_ble_cmd",
