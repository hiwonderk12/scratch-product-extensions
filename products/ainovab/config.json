          },
          {
            "id": "infrared",
            "name": {
              "zh-cn": "红外遥控",
              "en": "ir remote control",
              "zh-tw": "紅外遙控",
              "ko": "적외선 원격 제어"
            },
            "blocks": [
              "when_get_irkey_thread",
              "when_irkey_longPress_thread",
              "when_irkey_stop_thread",
              "send_irkey",
              "learn_mode",
              "send_learn_code"
            ]
          }
        ]
      }
    ],
    "blocks": {
      "start_thread": {
        "blockIcon": "_images/block.svg",
        "section": "main",
        "launcher": "Hiwonder.startMain({MAIN})"
      },
      "start_run_thread": {
        "blockIcon": "_images/block.svg",
        "section": "setup"
      },
      "when_key_click_thread": {
        "blockIcon": "_images/block.svg",
        "section": "main",
        "entryTemplate": "def on_button_{BUTTON}_clicked():",
        "entryFooter": "Hiwonder.Button_{BUTTON}.Clicked(on_button_{BUTTON}_clicked)"
      },
      "when_key_long_pressed_thread": {
        "blockIcon": "_images/block.svg",
        "section": "main",
        "entryTemplate": "def on_button_{BUTTON}_longPressed():",
        "entryFooter": "Hiwonder.Button_{BUTTON}.Longpressed(on_button_{BUTTON}_longPressed)"
      },
      "en_motorSetType": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "TYPE",
          "cases": {
            "0": "en_motor.setType(en_motor.TT_MOTOR)",
            "1": "en_motor.setType(en_motor.N20_MOTOR)"
          }
        }
      },
      "en_motorResetCounter": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "INDEX",
          "cases": {
            "0": "en_motor.resetCounter(en_motor.AllMotor)",
            "1": "en_motor.resetCounter(en_motor.Motor1)",
            "2": "en_motor.resetCounter(en_motor.Motor2)"
          }
        }
      },
      "en_motorSetSpeed": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "INDEX",
          "cases": {
            "0": "en_motor.setSpeed(en_motor.AllMotor,{NUM})",
            "1": "en_motor.setSpeed(en_motor.Motor1,{NUM})",
            "2": "en_motor.setSpeed(en_motor.Motor2,{NUM})"
          }
        },
        "arguments": {
          "NUM": {
            "type": "slider200",
            "defaultValue": 30
          }
        }
      },
      "en_motorSetSpeedArg": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "INDEX",
          "matchInputCode": true,
          "cases": {
            "0": "en_motor.setSpeed(en_motor.AllMotor,{NUM})",
            "1": "en_motor.setSpeed(en_motor.Motor1,{NUM})",
            "2": "en_motor.setSpeed(en_motor.Motor2,{NUM})"
          }
        },
        "arguments": {
          "NUM": {
            "type": "slider200",
            "defaultValue": 30
          }
        }
      },
      "en_motorGetSpeed": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "INDEX",
          "cases": {
            "0": "en_motor.getSpeed(en_motor.AllMotor)",
            "1": "en_motor.getSpeed(en_motor.Motor1)",
            "2": "en_motor.getSpeed(en_motor.Motor2)"
          }
        }
      },
      "en_motorGetCounter": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "INDEX",
          "cases": {
            "0": "en_motor.getCounter(en_motor.AllMotor)",
            "1": "en_motor.getCounter(en_motor.Motor1)",
            "2": "en_motor.getCounter(en_motor.Motor2)"
          }
        }
      },
      "en_motorStop": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "INDEX",
          "cases": {
            "0": "en_motor.stop(en_motor.AllMotor)",
            "1": "en_motor.stop(en_motor.Motor1)",
            "2": "en_motor.stop(en_motor.Motor2)"
          }
        }
      },
      "en_motorDrawInit": {
        "blockIcon": "_images/block.svg"
      },
      "en_motorDrawPutData": {
        "blockIcon": "_images/block.svg"
      },
      "en_motorTurn": {
        "blockIcon": "_images/block.svg"
      },
      "motor_speed_set": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "ORIENTION",
          "cases": {
            "1": "Motor.setSpeed({SPEED},{SPEED})",
            "2": "Motor.setSpeed(-{SPEED},-{SPEED})",
            "3": "Motor.setSpeed({SPEED},-{SPEED})",
            "4": "Motor.setSpeed(-{SPEED},{SPEED})"
          }
        },
        "arguments": {
          "SPEED": {
            "type": "slider",
            "defaultValue": 60
          }
        }
      },
      "motor_speed_set_arg": {
        "blockIcon": "_images/block.svg",
        "arguments": {
          "SPEED": {
            "type": "slider100",
            "defaultValue": 60
          }
        }
      },
      "motor_speed_set_wheel": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "WHEEL",
          "cases": {
            "1": "Motor.setSpeed(M2=(-({SPEED}) if {ORIENTION} == 2 else {SPEED}))",
            "2": "Motor.setSpeed(M1=(-({SPEED}) if {ORIENTION} == 2 else {SPEED}))"
          }
        },
        "arguments": {
          "SPEED": {
            "type": "slider",
            "defaultValue": 60
          }
        }
      },
      "motor_speed_stop": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "WHEEL",
          "cases": {
            "1": "Motor.setSpeed(M2=0)",
            "2": "Motor.setSpeed(M1=0)",
            "3": "Motor.setSpeed(0,0)"
          }
        }
      },
      "pid_value": {
        "blockIcon": "_images/block.svg"
      },
      "set_pid_value": {
        "blockIcon": "_images/block.svg"
      },
      "update_pid_value": {
        "blockIcon": "_images/block.svg"
      },
      "output_pid_value": {
        "blockIcon": "_images/block.svg"
      },
      "reset_pid_value": {
        "blockIcon": "_images/block.svg"
      },
      "print_str": {
        "blockIcon": "_images/block.svg"
      },
      "print_number": {
        "blockIcon": "_images/block.svg"
      },
      "led_color_set": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "NUMS",
          "cases": {
            "0": "Hiwonder.Neopixel_onboard.setItem(0,{RED},{GREEN},{BLUE})\nHiwonder.Neopixel_onboard.write()",
            "1": "Hiwonder.Neopixel_onboard.setItem(1,{RED},{GREEN},{BLUE})\nHiwonder.Neopixel_onboard.write()",
            "2": "Hiwonder.Neopixel_onboard.setItem(2,{RED},{GREEN},{BLUE})\nHiwonder.Neopixel_onboard.write()",
            "3": "Hiwonder.Neopixel_onboard.setItem(3,{RED},{GREEN},{BLUE})\nHiwonder.Neopixel_onboard.write()",
            "4": "Hiwonder.Neopixel_onboard.setItem(4,{RED},{GREEN},{BLUE})\nHiwonder.Neopixel_onboard.write()",
            "5": "Hiwonder.Neopixel_onboard.setItem(5,{RED},{GREEN},{BLUE})\nHiwonder.Neopixel_onboard.write()",
            "6": "Hiwonder.Neopixel_onboard.fill({RED},{GREEN},{BLUE})"
          }
        },
        "arguments": {
          "RED": {
            "type": "slider255",
            "defaultValue": 255
          },
          "GREEN": {
            "type": "slider255",
            "defaultValue": 0
          },
          "BLUE": {
            "type": "slider255",
            "defaultValue": 0
          }
        }
      },
      "led_color_set_arg": {
        "blockIcon": "_images/block.svg",
        "arguments": {
          "RED": {
            "type": "slider255",
            "defaultValue": 255
          },
          "GREEN": {
            "type": "slider255",
            "defaultValue": 0
          },
          "BLUE": {
            "type": "slider255",
            "defaultValue": 0
          }
        }
      },
      "led_color_select": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "NUMS",
          "cases": {
            "0": "Hiwonder.Neopixel_onboard.setItem(0,{COLOR.rgb})\nHiwonder.Neopixel_onboard.write()",
            "1": "Hiwonder.Neopixel_onboard.setItem(1,{COLOR.rgb})\nHiwonder.Neopixel_onboard.write()",
            "2": "Hiwonder.Neopixel_onboard.setItem(2,{COLOR.rgb})\nHiwonder.Neopixel_onboard.write()",
            "3": "Hiwonder.Neopixel_onboard.setItem(3,{COLOR.rgb})\nHiwonder.Neopixel_onboard.write()",
            "4": "Hiwonder.Neopixel_onboard.setItem(4,{COLOR.rgb})\nHiwonder.Neopixel_onboard.write()",
            "5": "Hiwonder.Neopixel_onboard.setItem(5,{COLOR.rgb})\nHiwonder.Neopixel_onboard.write()",
            "6": "Hiwonder.Neopixel_onboard.fill({COLOR.rgb})"
          }
        },
        "arguments": {
          "COLOR": {
            "type": "square_color",
            "defaultValue": "#ff0000"
          }
        }
      },
      "led_close": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "NUMS",
          "cases": {
            "0": "Hiwonder.Neopixel_onboard.setItem(0,0,0,0)\nHiwonder.Neopixel_onboard.write()",
            "1": "Hiwonder.Neopixel_onboard.setItem(1,0,0,0)\nHiwonder.Neopixel_onboard.write()",
            "2": "Hiwonder.Neopixel_onboard.setItem(2,0,0,0)\nHiwonder.Neopixel_onboard.write()",
            "3": "Hiwonder.Neopixel_onboard.setItem(3,0,0,0)\nHiwonder.Neopixel_onboard.write()",
            "4": "Hiwonder.Neopixel_onboard.setItem(4,0,0,0)\nHiwonder.Neopixel_onboard.write()",
            "5": "Hiwonder.Neopixel_onboard.setItem(5,0,0,0)\nHiwonder.Neopixel_onboard.write()",
            "6": "Hiwonder.Neopixel_onboard.clear()\ntime.sleep(0.01)"
          }
        }
      },
      "buzzer_tone_set": {
        "blockIcon": "_images/block.svg"
      },
      "buzzer_tone_set_arg": {
        "blockIcon": "_images/block.svg"
      },
      "buzzer_play_melody": {
        "blockIcon": "_images/block.svg"
      },
      "set_buzzer_bpm": {
        "blockIcon": "_images/block.svg"
      },
      "get_buzzer_bpm": {
        "blockIcon": "_images/block.svg"
      },
      "set_buzzer_volume": {
        "blockIcon": "_images/block.svg"
      },
      "buzzer_isFinish": {
        "blockIcon": "_images/block.svg"
      },
      "disable_lowPower_alarm": {
        "blockIcon": "_images/block.svg"
      },
      "key_detect": {
        "blockIcon": "_images/block.svg"
      },
      "get_sound": {
        "blockIcon": "_images/block.svg"
      },
      "get_battery_level": {
        "blockIcon": "_images/block.svg"
      },
      "set_ble_mode": {
        "blockIcon": "_images/block.svg",
        "templateSelector": {
          "argument": "MODE",
          "cases": {
            "3": "ble = Hiwonder_BLE.BLE(Hiwonder_BLE.MODE_BLE_SLAVE, name = {NAME})",
            "4": "ble = Hiwonder_BLE.BLE(Hiwonder_BLE.MODE_BLE_MASTER, name = {NAME})"
          }
        }
      },
      "ble_is_connected": {
        "blockIcon": "_images/block.svg"
      },
      "get_ble_mac": {
        "blockIcon": "_images/block.svg"
      },
      "ble_wait_end": {
        "blockIcon": "_images/block.svg"
      },
      "read_ble_data": {
        "blockIcon": "_images/block.svg"
      },
      "get_ble_cmd": {
        "blockIcon": "_images/block.svg"
      },
      "get_ble_args": {
        "blockIcon": "_images/block.svg"
      },
      "ble_write": {
        "blockIcon": "_images/block.svg"
      },
      "when_get_irkey_thread": {
        "blockIcon": "_images/block.svg",
        "section": "main",
        "entryTemplate": "def on_irkey_{IRKEY}_clicked():",
        "entryFooter": "Hiwonder.Ir.Clicked(Hiwonder.Ir.{IRKEY},on_irkey_{IRKEY}_clicked)"
      },
      "when_irkey_longPress_thread": {
        "blockIcon": "_images/block.svg",
        "section": "main",
        "entryTemplate": "def on_irkey_{IRKEY}_longPressed():",
        "entryFooter": "Hiwonder.Ir.Longpressed(Hiwonder.Ir.{IRKEY},on_irkey_{IRKEY}_longPressed)"
      },
      "when_irkey_stop_thread": {
        "blockIcon": "_images/block.svg",
        "section": "main",
        "entryTemplate": "def on_irkey_released_lp():",
        "entryFooter": "Hiwonder.Ir.Released_lp(on_irkey_released_lp)"
      },
      "send_irkey": {
        "blockIcon": "_images/block.svg"
      },
      "learn_mode": {
        "blockIcon": "_images/block.svg"
      },
      "send_learn_code": {
        "blockIcon": "_images/block.svg"
      }
    }
  },
  "asset": {
    "python": {
      "dir": "python/",
      "version": "0.1.2",
      "main": "main.ts",
      "dependencies": {},
      "files": [
        "_menus/index.json",
        "_images/icon.svg",
        "_images/block.svg",
        "_images/product-cards/wondercode-ainovab.png",
        "_locales/zh-cn.json",
        "_locales/en.json",
        "_locales/zh-tw.json",
        "_locales/ko.json"
      ]
    }
  }
}
