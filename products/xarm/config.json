{
  "name": {
    "zh-cn": "机械臂模块",
    "en": "Robot Arm Modules"
  },
  "description": {
    "zh-cn": "适用于 Hiwonder Python 产品的机械臂积木包。",
    "en": "Robot arm blocks for Hiwonder Python products."
  },
  "author": "Hiwonder",
  "license": "MIT",
  "isBoard": false,
  "id": "xarm",
  "platform": [
    "win",
    "mac",
    "web",
    "linux"
  ],
  "version": "1.1.3",
  "scratchEditor": {
    "color1": "#00B2EE",
    "color2": "#00B2EE",
    "color3": "#00B2EE",
    "categories": [
      {
        "id": "xarm",
        "name": "机械臂",
        "blocks": [
          "aimech_set_arm_id",
          "aimech_set_claw_id",
          "aimech_servo_enable",
          "aimech_servo_disable",
          "aimech_set_servo_pose_time",
          "aimech_get_angle",
          "aimech_set_servo_stop"
        ]
      },
      {
        "id": "xarm-series",
        "name": "AI机甲串联机械臂",
        "blocks": [
          "aimech_3dof_arm_init",
          "aimech_3dof_arm_move"
        ]
      },
      {
        "id": "xarm-linkage",
        "name": "连杆机械臂",
        "blocks": [
          "aimech_rod_arm_init",
          "aimech_rod_reach_detect",
          "aimech_rod_arm_move"
        ]
      }
    ],
    "blocks": {
      "aimech_set_arm_id": {
        "blockIcon": "_images/blocks/claw.svg"
      },
      "aimech_set_claw_id": {
        "blockIcon": "_images/blocks/claw.svg"
      },
      "aimech_servo_enable": {
        "blockIcon": "_images/blocks/claw.svg"
      },
      "aimech_servo_disable": {
        "blockIcon": "_images/blocks/claw.svg"
      },
      "aimech_set_servo_pose_time": {
        "blockIcon": "_images/blocks/claw.svg",
        "arguments": {
          "POS": {
            "type": "slider1000"
          }
        }
      },
      "aimech_get_angle": {
        "blockIcon": "_images/blocks/claw.svg"
      },
      "aimech_set_servo_stop": {
        "blockIcon": "_images/blocks/claw.svg"
      },
      "aimech_3dof_arm_init": {
        "blockIcon": "_images/blocks/claw.svg"
      },
      "aimech_3dof_arm_move": {
        "blockIcon": "_images/blocks/claw.svg"
      }
    }
  },
  "asset": {
    "python": {
      "dir": "python/",
      "version": "1.1.3",
      "main": "main.ts",
      "dependencies": {},
      "files": [
        "_menus/index.json"
      ]
    }
