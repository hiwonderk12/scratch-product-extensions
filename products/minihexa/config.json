{
  "name": {"zh-cn": "miniHexa", "en": "miniHexa"},
  "description": {
    "zh-cn": "适用于 miniHexa 六足机器人的 Python 积木拓展包。",
    "en": "Python block extension package for the miniHexa hexapod robot."
  },
  "author": "Hiwonder",
  "license": "MIT",
  "isBoard": false,
  "id": "minihexa",
  "platform": ["win", "mac", "web", "linux"],
  "version": "0.1.3",
  "scratchEditor": {
    "categories": [
      {"id": "entry", "name": "", "hideLabel": true, "blocks": ["start_thread", "start_run_thread"]},
      {
        "id": "board_resource",
        "name": "板载资源",
        "blocks": ["buzzer_tone_set", "buzzer_tone_set_arg", "buzzer_tone_set_volume", "get_battery_level", "get_volume", "disable_lowPower_alarm"]
      },
      {"id": "output", "name": "输出打印", "blocks": ["print_str", "print_number"]},
      {
        "id": "kinematics",
        "name": "运动控制",
        "blocks": ["set_body_reset", "set_body_angle", "set_body_pose", "set_body_pose_height", "set_go", "set_go_step", "set_move_xyz", "set_move_xyz_step", "set_turn", "set_turn_step", "set_go_stop", "set_leg_lift", "set_self_balance"]
      },
      {"id": "servo_control", "name": "舵机控制", "blocks": ["set_servo"]},
      {"id": "action_group", "name": "动作组", "blocks": ["action_run", "action_stop"]},
      {"id": "keys", "name": "按键", "blocks": ["when_minihexa_key_click_thread", "when_minihexa_key_longclick_thread", "key_is_pressed"]},
      {"id": "imu_sensor", "name": "IMU传感器", "blocks": ["imu_read_gyro_data", "imu_read_angle"]},
      {
        "id": "serial_communication",
        "name": "串口通信",
        "blocks": ["serial_set_baudrate", "serial_write", "serial_has_recv_data", "serial_recv_contains", "serial_recv_buff", "get_serial_cmd", "get_serial_args", "clear_buffer"]
      }
    ],
    "blocks": {
      "start_thread": {"section": "main", "launcher": "Hiwonder.startMain({MAIN})"},
      "start_run_thread": {"section": "setup"},
      "set_body_angle": {
        "templateSelector": {
          "argument": "ANGLE",
          "cases": {
            "1": "minihexa.set_body_angle([{VALUE},0,0],{DURATION})",
            "2": "minihexa.set_body_angle([0,{VALUE},0],{DURATION})",
            "3": "minihexa.set_body_angle([0,0,{VALUE}],{DURATION})"
          }
        }
      },
      "set_body_pose": {
        "templateSelector": {
          "argument": "ORIENTION",
          "cases": {
            "0": "minihexa.set_body_pose([0,{VALUE},0],{DURATION})",
            "1": "minihexa.set_body_pose([0,-{VALUE},0],{DURATION})",
            "2": "minihexa.set_body_pose([-{VALUE},0,0],{DURATION})",
            "3": "minihexa.set_body_pose([{VALUE},0,0],{DURATION})",
            "4": "minihexa.set_body_pose([-{VALUE},{VALUE},0],{DURATION})",
            "5": "minihexa.set_body_pose([{VALUE},{VALUE},0],{DURATION})",
            "6": "minihexa.set_body_pose([-{VALUE},-{VALUE},0],{DURATION})",
            "7": "minihexa.set_body_pose([{VALUE},-{VALUE},0],{DURATION})"
          }
        }
      },
      "set_go": {
        "templateSelector": {
          "argument": "MOVE",
          "cases": {
            "0": "minihexa.go([0,{SPEED},0],-1,{DURATION})",
            "1": "minihexa.go([0,-{SPEED},0],-1,{DURATION})",
            "2": "minihexa.go([-{SPEED},0,0],-1,{DURATION})",
            "3": "minihexa.go([{SPEED},0,0],-1,{DURATION})",
            "4": "minihexa.go([-{SPEED},{SPEED},0],-1,{DURATION})",
            "5": "minihexa.go([{SPEED},{SPEED},0],-1,{DURATION})",
            "6": "minihexa.go([-{SPEED},-{SPEED},0],-1,{DURATION})",
            "7": "minihexa.go([{SPEED},-{SPEED},0],-1,{DURATION})"
          }
        }
      },
      "set_go_step": {
        "templateSelector": {
          "argument": "MOVE",
          "cases": {
            "0": "minihexa.go([0,{SPEED},0],{STEP},{DURATION})",
            "1": "minihexa.go([0,-{SPEED},0],{STEP},{DURATION})",
            "2": "minihexa.go([-{SPEED},0,0],{STEP},{DURATION})",
            "3": "minihexa.go([{SPEED},0,0],{STEP},{DURATION})",
            "4": "minihexa.go([-{SPEED},{SPEED},0],{STEP},{DURATION})",
            "5": "minihexa.go([{SPEED},{SPEED},0],{STEP},{DURATION})",
            "6": "minihexa.go([-{SPEED},-{SPEED},0],{STEP},{DURATION})",
            "7": "minihexa.go([{SPEED},-{SPEED},0],{STEP},{DURATION})"
          }
        }
      },
      "set_turn": {
        "templateSelector": {
          "argument": "MOVE",
          "cases": {
            "1": "minihexa.go([0,0,-{SPEED}],-1,{DURATION})",
            "2": "minihexa.go([0,0,{SPEED}],-1,{DURATION})"
          }
        }
      },
      "set_turn_step": {
        "templateSelector": {
          "argument": "MOVE",
          "cases": {
            "1": "minihexa.go([0,0,-{SPEED}],{STEP},{DURATION})",
            "2": "minihexa.go([0,0,{SPEED}],{STEP},{DURATION})"
          }
        }
      },
      "when_minihexa_key_click_thread": {
        "section": "main",
        "entryTemplate": "def on_button1_clicked():",
        "entryFooter": "button1.Clicked(on_button1_clicked)"
      },
      "when_minihexa_key_longclick_thread": {
        "section": "main",
        "entryTemplate": "def on_button1_longpressed():",
        "entryFooter": "button1.Longpressed(on_button1_longpressed)"
      },
      "buzzer_tone_set_volume": {
        "arguments": {
          "VALUE": {"type": "slider"}
        }
      }
    }
  },
  "asset": {
    "python": {
      "dir": "python/",
      "version": "0.1.3",
      "main": "main.ts",
      "dependencies": {},
      "files": ["_menus/index.json"]
    }
  }
}
