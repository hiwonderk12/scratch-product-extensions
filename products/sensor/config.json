          "aiquadruped",
          "aiquadrupedpro",
          "aihexa",
          "minihexa"
        ]
      },
      "linefollower6_one_status": {
        "templateSelector": {
          "argument": "LINE",
          "cases": {
            "0": "(linefollow6.get_result_data() & {NUM}) == 0",
            "1": "(linefollow6.get_result_data() & {NUM}) > 0"
          }
        },
        "blockIcon": "_images/linefollow.svg"
      },
      "linefollower6_status": {
        "arguments": {
          "LINE": {
            "type": "line6",
            "defaultValue": "00"
          }
        },
        "blockIcon": "_images/linefollow.svg"
      },
      "linefollower8_one_status": {
        "templateSelector": {
