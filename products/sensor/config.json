    "blocks": {
      "aimech_wondercamInitI2c": {
        "products": [
          "aimech",
          "aimecanum",
          "aiquadruped",
          "aiquadrupedpro",
          "aihexa"
        ]
      },
      "minihexa_wondercamInitI2c": {
        "products": [
          "minihexa"
        ]
      },
      "getFwVersion": {
        "products": [
          "aimech",
          "aimecanum",
          "aiquadruped",
          "aiquadrupedpro",
          "aihexa",
          "minihexa"
        ]
      },
      "getFuncNumber": {
        "products": [
          "aimech",
          "aimecanum",
          "aiquadruped",
          "aiquadrupedpro",
          "aihexa",
          "minihexa"
        ],
        "templateSelector": {
          "argument": "NUM",
          "cases": {
            "0": "cam.FuncNone",
            "1": "cam.FaceDetect",
            "2": "cam.ObjectDetect",
            "3": "cam.Classification",
            "4": "cam.FeatureLearning",
            "5": "cam.ColorDetect",
            "6": "cam.LineFollowing",
            "7": "cam.AprilTag",
            "8": "cam.QrCode",
            "9": "cam.BarCode"
          }
        }
      },
      "getCurrentFunc": {
        "products": [
          "aimech",
          "aimecanum",
          "aiquadruped",
          "aiquadrupedpro",
          "aihexa",
          "minihexa"
        ]
      },
      "switchFunc": {
        "products": [
          "aimech",
          "aimecanum",
          "aiquadruped",
          "aiquadrupedpro",
          "aihexa",
          "minihexa"
        ],
        "templateSelector": {
          "argument": "NUM",
          "cases": {
            "0": "cam.switchFunc(cam.FuncNone)",
            "1": "cam.switchFunc(cam.FaceDetect)",
            "2": "cam.switchFunc(cam.ObjectDetect)",
            "3": "cam.switchFunc(cam.Classification)",
            "4": "cam.switchFunc(cam.FeatureLearning)",
            "5": "cam.switchFunc(cam.ColorDetect)",
            "6": "cam.switchFunc(cam.LineFollowing)",
            "7": "cam.switchFunc(cam.AprilTag)",
            "8": "cam.switchFunc(cam.QrCode)",
            "9": "cam.switchFunc(cam.BarCode)",
            "10": "cam.switchFunc(cam.NumberRecognition)",
            "11": "cam.switchFunc(cam.LandmarkRecognition)"
          }
        }
      },
      "setLed": {
        "products": [
          "aimech",
          "aimecanum",
          "aiquadruped",
          "aiquadrupedpro",
          "aihexa",
          "minihexa"
        ],
        "templateSelector": {
          "argument": "ONOFF",
          "cases": {
            "0": "cam.setLed(cam.LED_OFF)",
            "1": "cam.setLed(cam.LED_ON)"
          }
        }
      },
      "wondercamUpdateResult": {
        "products": [
          "aimech",
          "aimecanum",
          "aiquadruped",
          "aiquadrupedpro",
          "aihexa",
          "minihexa"
        ]
      },
      "isAnyFaceDetected": {
        "products": [
