    "en": "适用于 AI机甲麦轮车的 Python 积木拓展包。"
  },
  "author": "Hiwonder",
  "license": "MIT",
  "isBoard": false,
  "id": "aimecanum",
  "platform": [
    "win",
    "mac",
    "web",
    "linux"
  ],
  "version": "0.2.8",
  "scratchEditor": {
    "color1": "#1874cd",
    "color2": "#1874cd",
    "color3": "#1874cd",
    "categories": [
      {
        "id": "main",
        "name": "主程序",
        "hideLabel": true,
        "blocks": [
          "start_thread",
          "start_run_thread",
          "wait_seconds"
        ]
      },
      {
        "id": "boardResource",
        "name": "板载资源",
        "hideLabel": false,
        "blocks": [
          "buzzer_tone_set",
          "buzzer_tone_set_arg",
          "buzzer_tone_set_volume",
          "close_buzzer",
          "close_lowpower_warning",
          "get_battery_level"
        ]
      },
      {
        "id": "rgb",
        "name": "RGB彩灯",
        "hideLabel": false,
        "blocks": [
          "set_led_color",
          "set_led_color_arg",
          "rgb_module_breath_one",
          "rgb_module_breath",
          "close_led"
        ]
      },
      {
        "id": "output",
        "name": "输出打印",
        "hideLabel": false,
        "blocks": [
          "print_str",
          "print_number"
        ]
      },
      {
        "id": "button",
        "name": "按键",
        "hideLabel": false,
        "blocks": [
          "when_key_click_thread",
          "when_key_longclick_thread",
          "key_is_pressed"
        ]
      },
      {
        "id": "motion",
        "name": "运动控制",
        "hideLabel": false,
        "blocks": [
          "set_motor_speed_all",
          "set_motor_speed_one",
          "set_motor_speed_two",
          "move_oriention",
          "move_oriention_angle",
          "set_x_y_speed",
          "move_stop",
          "move_distance",
          "move_distance_arg",
          "move_all",
          "move_all_angle",
          "turn_percent",
          "turn_speed",
          "get_motor_angle",
          "reset_motor",
          "is_motor_ready",
          "is_all_ready",
          "pd_set_pd_line"
        ]
      },
      {
        "id": "imu",
        "name": "IMU传感器",
        "hideLabel": false,
        "blocks": [
          "imu_init",
          "imu_cali",
          "get_euler_angle_element_value"
        ]
      },
      {
        "id": "lineFollower",
        "name": "六路巡线传感器",
        "hideLabel": false,
        "blocks": [
          "linefollower6_one_status",
          "linefollower6_status",
          "linefollower6_set_threshold",
          "linefollower6_get_value",
          "linefollower6_read_offset"
        ]
      },
      {
        "id": "ultrasonic",
        "name": "超声波传感器",
        "hideLabel": false,
        "blocks": [
          "get_led_ultrasonic_distance",
          "set_led_ultrasonic_color",
          "set_led_ultrasonic_color_arg",
          "close_led_ultrasonic",
          "set_led_ultrasonic_breath",
          "set_led_ultrasonic_random"
        ]
      },
      {
        "id": "bluetooth",
        "name": "蓝牙通信",
        "hideLabel": false,
        "blocks": [
          "set_ble_mode",
          "ble_is_connected",
          "get_ble_mac",
          "ble_wait_end",
          "read_ble_data",
          "get_ble_cmd",
          "get_ble_args",
          "ble_write"
        ]
      }
    ],
    "blocks": {
      "start_thread": {
        "launcher": "Hiwonder.startMain({MAIN})",
        "section": "main"
      },
      "start_run_thread": {
        "section": "setup"
      },
      "when_key_click_thread": {
        "entryTemplate": "def on_button{KEYS}_clicked():",
        "entryFooter": "button{KEYS}.Clicked(on_button{KEYS}_clicked)",
        "section": "main"
      },
      "when_key_longclick_thread": {
        "entryTemplate": "def on_button{KEYS}_longpressed():",
        "entryFooter": "button{KEYS}.Longpressed(on_button{KEYS}_longpressed)",
        "section": "main"
      },
      "linefollower6_status": {
        "arguments": {
          "LINE": {
            "type": "line6",
            "defaultValue": "00"
          }
        }
      }
    }
  },
  "asset": {
    "python": {
      "dir": "python/",
      "version": "0.2.8",
      "main": "main.ts",
      "dependencies": {},
      "files": [
        "_menus/index.json"
      ]
    }
  }
}
